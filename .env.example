# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY PAYMENT GATEWAY CREDENTIALS (Configure in Vercel & AI Studio Settings)
# Get your API keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# In Test Mode: Starts with 'rzp_test_...'
# In Live Mode: Starts with 'rzp_live_...'
RAZORPAY_KEY_ID=""

# NEVER expose RAZORPAY_KEY_SECRET in frontend or client-side code!
# It is used strictly in server-side API routes to verify HMAC SHA256 signatures.
RAZORPAY_KEY_SECRET=""

# RAZORPAY WEBHOOK SECRET
# Webhook URL to configure in Razorpay: https://your-domain.vercel.app/api/payment/webhook
# Events to select: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=""
